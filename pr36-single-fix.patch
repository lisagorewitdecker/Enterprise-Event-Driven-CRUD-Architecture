+async function connectKafkaWithRetry({ retries = 20, baseDelayMs = 1000 } = {}) {
+  if (kafkaConnected || kafkaConnecting) return;
+  kafkaConnecting = true;
+  try {
+    let attempt = 0;
+    while (!kafkaConnected && attempt < retries) {
+      attempt += 1;
+      try {
+        await producer.connect();
+        kafkaConnected = true;
+        console.log('Kafka Producer connected.');
+        return;
+      } catch (err) {
+        const delay = Math.min(baseDelayMs * attempt, 10000);
+        console.warn(`Kafka connect attempt ${attempt}/${retries} failed: ${err.message}. Retrying in ${delay}ms`);
+        await sleep(delay);
+      }
+    }
+    throw new Error('Kafka producer could not connect after retries');
+  } finally {
+    kafkaConnecting = false;
   }
 }

